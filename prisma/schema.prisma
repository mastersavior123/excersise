// WOD Compiler — Phase 0(지식베이스) + Phase 1(회원가입·온보딩) 스키마
// Phase 0: crossfit_programming_knowledge_base.xlsx 10개 지식베이스 시트를 정규화한 읽기 전용 테이블
// Phase 1: 회원가입/온보딩/1RM 입력을 위한 사용자 도메인 테이블 (program 등 생성 엔진 테이블은 Phase 2)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Exercise_DB (115행) — 운동 마스터
// ---------------------------------------------------------------------------
model Exercise {
  exerciseId        String  @id @map("exercise_id") // 'EX001'
  nameKo             String  @map("name_ko")
  nameEn             String  @map("name_en")
  modality            String // 체조 | 웨이트리프팅 | 모노스트럭처럴
  family               String // 스쿼트 | 힌지 | 스내치 | 클린 | 저크 | 캐리 ...
  primaryPattern        String[] @map("primary_pattern") // '+' 구분 원문을 분리
  recommendedSlots       String[] @map("recommended_slots") // '/' 구분 원문을 분리
  equipment               String[] // '/' 구분 원문을 분리 (단일값도 배열 1개로 저장)
  minLevel                 Int      @map("min_level")
  skillComplexity           Int      @map("skill_complexity") // 1~5
  impact                     String // 낮음 | 중간 | 높음
  doseUnit                    String   @map("dose_unit") // 회 | 품질회 | 세트×회 | m | 분 ...
  defaultDoseRaw                String   @map("default_dose_raw") // 원문 그대로: '3~5×6~12 @RIR2~4'
  defaultDoseSetsMin              Int?     @map("default_dose_sets_min")
  defaultDoseSetsMax              Int?     @map("default_dose_sets_max")
  defaultDoseRepsMin              Int?     @map("default_dose_reps_min")
  defaultDoseRepsMax              Int?     @map("default_dose_reps_max")
  relativeLoad                      String   @map("relative_load") // 무부하 / 가벼움~중간 등 자유 텍스트
  regressionText                      String?  @map("regression_text") // 원문 그대로 (감사용)
  progressionText                      String?  @map("progression_text")
  contraindications                     String?
  sourceId                                String   @map("source_id")
  sourceUrl                                String?  @map("source_url")
  openRx2017to26                            Boolean  @default(false) @map("open_rx_2017_26")
  openWorkoutCount                            Int      @default(0) @map("open_workout_count")
  openSeasons                                  Int[]    @map("open_seasons")
  openWorkouts                                  String[] @map("open_workouts")
  mostRecentOpenYear                              Int?     @map("most_recent_open_year")
  crossfitMovementsUrl                              String?  @map("crossfit_movements_url")
  officialYoutubeUrl                                  String?  @map("official_youtube_url")

  aliases              ExerciseAlias[]
  relationsFrom        ExerciseRelation[]      @relation("relation_from")
  relationsTo          ExerciseRelation[]      @relation("relation_to")
  openWorkoutMovements OpenWorkoutMovement[]
  officialMedia        OfficialMedia[]
  scalingAsOriginal    ScalingMap[]            @relation("scaling_original")
  scalingAsRegression1 ScalingMap[]            @relation("scaling_regression1")
  scalingAsRegression2 ScalingMap[]            @relation("scaling_regression2")
  programBlocks        ProgramBlock[]

  @@index([family])
  @@index([minLevel])
  @@map("exercise")
}

// 한글명/English 및 회귀·진행·Scaling_Map에 등장하는 표기 변형을 ExerciseID로 정규화
model ExerciseAlias {
  aliasName  String   @id @map("alias_name")
  exerciseId String   @map("exercise_id")
  exercise   Exercise @relation(fields: [exerciseId], references: [exerciseId])

  @@map("exercise_alias")
}

// 회귀/진행 체인을 ID 관계로 저장 (한 운동이 복수의 회귀 옵션을 가질 수 있어 unique 제약을 두지 않음)
model ExerciseRelation {
  id               Int      @id @default(autoincrement())
  exerciseId       String   @map("exercise_id")
  exercise         Exercise @relation("relation_from", fields: [exerciseId], references: [exerciseId])
  relationType     String   @map("relation_type") // 'regression' | 'progression'
  orderIndex       Int      @default(0) @map("order_index") // 원문 내 등장 순서 (0 = 1차)
  targetExerciseId String   @map("target_exercise_id")
  targetExercise   Exercise @relation("relation_to", fields: [targetExerciseId], references: [exerciseId])

  @@index([exerciseId, relationType])
  @@map("exercise_relation")
}

// ---------------------------------------------------------------------------
// Level_Profiles (4행: Level 1~4)
// ---------------------------------------------------------------------------
model LevelProfile {
  level               Int     @id
  groupName            String  @map("group_name") // 초급자/중급자/고급자/선수급
  weeklyFrequency        String  @map("weekly_frequency")
  criteriaText            String  @map("criteria_text")
  sessionMinutesRange       String  @map("session_minutes_range")
  weeklyStructure            String  @map("weekly_structure")
  highIntensityCap            String  @map("high_intensity_cap")
  consecutiveDayCap             String  @map("consecutive_day_cap")
  weeklyGoal                     String  @map("weekly_goal")
  cautions                        String?
  defaultDeload                    String  @map("default_deload")

  volumeLedgerRules VolumeLedgerRule[]

  @@map("level_profile")
}

// ---------------------------------------------------------------------------
// Volume_Rules (V01~V06 × Level = 24행)
// ---------------------------------------------------------------------------
model VolumeLedgerRule {
  id                Int          @id @default(autoincrement())
  ledgerId            String       @map("ledger_id") // 'V01'..'V06'
  ledgerName            String       @map("ledger_name")
  level                   Int
  levelProfile              LevelProfile @relation(fields: [level], references: [level])
  minValue                    Decimal      @map("min_value")
  maxValue                      Decimal      @map("max_value")
  unit                             String
  aggregationRule                    String       @map("aggregation_rule")
  usageNote                            String?      @map("usage_note")
  evidenceStatus                          String?      @map("evidence_status")

  @@unique([ledgerId, level])
  @@map("volume_ledger_rule")
}

// ---------------------------------------------------------------------------
// Session_Templates (T4-1..T4-4, T5-1..T5-5 = 9행)
// ---------------------------------------------------------------------------
model SessionTemplate {
  templateId          String  @id @map("template_id") // 'T4-1'
  frequency             String // '4일' | '5일'
  dayLabel                String  @map("day_label") // 'Day 1'
  dayType                   String  @map("day_type") // '큰 날' | '작은 날' | '중간/혼합'
  slotSequenceRaw             String  @map("slot_sequence_raw") // 화살표(→) 원문
  slotSequenceParsed             String[] @map("slot_sequence_parsed") // 코드 슬롯으로 정규화 (seed 시 수동 매핑)
  conditioning                     String?
  recommendedWeekday                 String?  @map("recommended_weekday")
  conflictNote                          String?  @map("conflict_note")

  programDays ProgramDay[]

  @@map("session_template")
}

// ---------------------------------------------------------------------------
// Generator_Rules (30행, 순서 보장)
// ---------------------------------------------------------------------------
model GeneratorRule {
  orderIndex     Int    @id @map("order_index")
  stage           String
  checkItem         String @map("check_item")
  conditionRule       String @map("condition_rule")
  action                 String // BLOCK | REPLACE | ADJUST | ...
  evidence                 String?

  @@map("generator_rule")
}

// ---------------------------------------------------------------------------
// Scaling_Map (20행) — 영문 동작명 기반, Exercise_DB와 완전히 1:1 매치되지 않을 수 있음
// ---------------------------------------------------------------------------
model ScalingMap {
  scaleId               String    @id @map("scale_id")
  originalText             String    @map("original_text")
  originalExerciseId          String?   @map("original_exercise_id")
  originalExercise               Exercise? @relation("scaling_original", fields: [originalExerciseId], references: [exerciseId])
  regression1Text                   String    @map("regression1_text")
  regression1ExerciseId                String?   @map("regression1_exercise_id")
  regression1Exercise                     Exercise? @relation("scaling_regression1", fields: [regression1ExerciseId], references: [exerciseId])
  regression2Text                            String    @map("regression2_text")
  regression2ExerciseId                         String?   @map("regression2_exercise_id")
  regression2Exercise                              Exercise? @relation("scaling_regression2", fields: [regression2ExerciseId], references: [exerciseId])
  preservedFunction                                   String    @map("preserved_function")
  stimulusTime                                           String    @map("stimulus_time")
  coachingNote                                              String?   @map("coaching_note")

  @@map("scaling_map")
}

// ---------------------------------------------------------------------------
// Enums (21행) — Level/Modality/DayType/Load/TimeDomain/Impact 코드표
// ---------------------------------------------------------------------------
model EnumLookup {
  enumType    String @map("enum_type")
  code         String
  labelKo       String @map("label_ko")
  description     String?

  @@id([enumType, code])
  @@map("enum_lookup")
}

// ---------------------------------------------------------------------------
// Open_Workouts (39행, 2017~2026)
// ---------------------------------------------------------------------------
model OpenWorkout {
  year                Int
  workout               String // '17.1'
  format                  String?
  timeCap                   String?  @map("time_cap")
  canonicalMovements          String[] @map("canonical_movements") // '|' 구분 원문을 분리
  structureNote                  String?  @map("structure_note")
  division                          String?
  sourceId                            String?  @map("source_id")
  officialUrl                            String?  @map("official_url")

  // open_workout_movement과의 직접 관계는 두지 않음: workouts_appeared_raw가 자유 텍스트라
  // (year, workout) 복합키로 항상 안전하게 조인할 수 없음. Phase 1에서 필요 시 조인 테이블 추가.

  @@id([year, workout])
  @@map("open_workout")
}

// ---------------------------------------------------------------------------
// Open_Movement_Index (44행)
// ---------------------------------------------------------------------------
model OpenWorkoutMovement {
  id                    Int      @id @default(autoincrement())
  canonicalMovement       String   @map("canonical_movement")
  exerciseId                 String   @map("exercise_id")
  exercise                      Exercise @relation(fields: [exerciseId], references: [exerciseId])
  workoutCount                    Int?     @map("workout_count")
  seasonCount                        Int?     @map("season_count")
  seasonsAppeared                       Int[]    @map("seasons_appeared")
  workoutsAppearedRaw                      String?  @map("workouts_appeared_raw") // 콤마 구분 원문 그대로 보관 (23.2A + 23.2B 같은 표기 보존)
  mostRecentYear                              Int?     @map("most_recent_year")
  normalizationNote                              String?  @map("normalization_note")
  officialYoutubeUrl                                String?  @map("official_youtube_url")
  crossfitMovementsUrl                                 String?  @map("crossfit_movements_url")

  // OpenWorkout과의 직접 FK는 두지 않음: workouts_appeared_raw가 자유 텍스트라
  // (year, workout) 복합키로 항상 안전하게 조인할 수 없음. Phase 1에서 필요 시 조인 테이블 추가.

  @@unique([canonicalMovement, exerciseId])
  @@map("open_workout_movement")
}

// ---------------------------------------------------------------------------
// Official_Videos (19행)
// ---------------------------------------------------------------------------
model OfficialMedia {
  videoId          String    @id @map("video_id") // 'YT001'
  movement            String
  exerciseId             String?   @map("exercise_id")
  exercise                   Exercise? @relation(fields: [exerciseId], references: [exerciseId])
  officialTitle                  String?   @map("official_title")
  purpose                            String?
  youtubeUrl                            String    @map("youtube_url")
  verifiedDate                              DateTime? @map("verified_date") @db.Date
  sourceId                                    String?   @map("source_id")

  @@map("official_media")
}

// =============================================================================
// Phase 1 — 사용자 도메인 (회원가입 · 온보딩 · 1RM 입력)
// =============================================================================

model AppUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  profile          UserProfile?
  oneRMs           UserOneRM[]
  capabilities     UserCapability[]
  healthFlags      UserHealthFlag[]
  levelAssessments UserLevelAssessment[]
  programs         Program[]

  @@map("app_user")
}

// 온보딩 Step 2·5의 기본 정보 + 가용 자원/목표. 단계마다 부분 저장되므로 필수 항목이 거의 없다 —
// "온보딩 완료" 여부는 API에서 별도로 판단한다(각 단계 데이터의 존재 여부로 계산).
model UserProfile {
  userId                     String   @id @map("user_id")
  user                       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                        Int?
  gender                     String?
  occupationActivity         String?  @map("occupation_activity") // sedentary | active | shift_work
  heightCm                   Decimal? @map("height_cm")
  weightKg                   Decimal? @map("weight_kg")
  recentTrainingFrequency    Int?     @map("recent_training_frequency") // 최근 8주 평균 주당 훈련일(0~7)
  trainingDaysPerWeek        Int?     @map("training_days_per_week") // 4 | 5
  sessionMinutesBudget       Int?     @map("session_minutes_budget")
  equipmentAvailable         String[] @default([]) @map("equipment_available")
  spaceType                  String?  @map("space_type")
  primaryGoals                String[] @default([]) @map("primary_goals") // 최대 2개, API에서 검증
  updatedAt                     DateTime @updatedAt @map("updated_at")

  @@map("user_profile")
}

// 5대 리프트 1RM 이력. lift별로 여러 번 기록될 수 있고 최신 measuredAt이 "현재 1RM"이다.
model UserOneRM {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id")
  user        AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lift        String // squat | deadlift | press | clean | snatch
  valueKg     Decimal  @map("value_kg")
  isEstimated Boolean  @default(false) @map("is_estimated") // Epley 등 추정 계산기로 입력했는지
  measuredAt  DateTime @default(now()) @map("measured_at") @db.Date

  @@unique([userId, lift, measuredAt])
  @@index([userId, lift])
  @@map("user_one_rm")
}

// 기술 체크리스트 (Level_Profiles 판정 근거). movementGroup은 4개 고정값:
// basic_squat_hinge_press_pull | oly_snatch | oly_clean_jerk | pullup_inversion
model UserCapability {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id")
  user           AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movementGroup  String   @map("movement_group")
  passed         Boolean
  checkedAt      DateTime @default(now()) @map("checked_at") @db.Date

  @@unique([userId, movementGroup])
  @@map("user_capability")
}

// Generator_Rules 1행(BLOCK 게이트)의 근거 데이터. acute_pain/chest_pain/fainting/neuro_symptom은
// 차단 플래그, surgery/pregnancy/cardio_warning은 주의 플래그로 API 레벨에서 구분해서 취급한다.
model UserHealthFlag {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  flagType  String   @map("flag_type")
  active    Boolean  @default(true)
  note      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, flagType])
  @@map("user_health_flag")
}

// 레벨 판정 이력. 재계산될 때마다 새 행을 추가해 이력을 남기고, finalLevel은 사용자가
// suggestedLevel을 조정한 값(기본은 suggestedLevel과 동일)이다.
model UserLevelAssessment {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id")
  user           AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  score          Decimal
  breakdown      Json // {"skill":7,"relativeOneRm":6,"frequency":8,"goal":5}
  suggestedLevel Int      @map("suggested_level")
  finalLevel     Int      @map("final_level")
  assessedAt     DateTime @default(now()) @map("assessed_at")

  @@map("user_level_assessment")
}

// =============================================================================
// Phase 2 — 프로그램 생성 엔진 (4주 블록)
// =============================================================================

model Program {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         Int // 생성 시점의 finalLevel 스냅샷 (이후 레벨이 바뀌어도 이 프로그램은 유지)
  frequency     Int // 4 | 5
  startDate     DateTime @map("start_date") @db.Date
  priorityGoals String[] @map("priority_goals")
  status        String   @default("active") // active | completed | archived
  createdAt     DateTime @default(now()) @map("created_at")

  weeks             ProgramWeek[]
  adjustmentEvents  ProgramAdjustmentEvent[]

  @@map("program")
}

model ProgramWeek {
  id             Int      @id @default(autoincrement())
  programId      String   @map("program_id")
  program        Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekIndex      Int      @map("week_index") // 1~4
  isDeload       Boolean  @default(false) @map("is_deload") // 기본적으로 4주차
  loadMultiplier Decimal  @default(1.0) @map("load_multiplier")

  days    ProgramDay[]
  ledgers WeeklyLedger[]

  @@unique([programId, weekIndex])
  @@map("program_week")
}

model ProgramDay {
  id            Int              @id @default(autoincrement())
  programWeekId Int              @map("program_week_id")
  programWeek   ProgramWeek      @relation(fields: [programWeekId], references: [id], onDelete: Cascade)
  date          DateTime         @db.Date
  dayType       String           @map("day_type") // big | small | mixed (session_template.day_type에서 파생)
  templateId    String?          @map("template_id")
  template      SessionTemplate? @relation(fields: [templateId], references: [templateId])

  blocks ProgramBlock[]
  log    TrainingLog?

  @@map("program_day")
}

model ProgramBlock {
  id           Int        @id @default(autoincrement())
  programDayId Int        @map("program_day_id")
  programDay   ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  slot         String // warmup | skill_power | main_strength | accessory | metcon | conditioning | cooldown
  orderIndex   Int        @map("order_index")
  exerciseId   String     @map("exercise_id")
  exercise     Exercise   @relation(fields: [exerciseId], references: [exerciseId])
  prescription Json // {doseRaw, setsMin?, setsMax?, repsMin?, repsMax?, loadKg?, percent1RM?}

  @@map("program_block")
}

// V01~V06 중 세션 템플릿·처방 데이터로 실제 계산 가능한 장부만 기록한다(엔진 코드 주석 참고).
model WeeklyLedger {
  id            Int         @id @default(autoincrement())
  programWeekId Int         @map("program_week_id")
  programWeek   ProgramWeek @relation(fields: [programWeekId], references: [id], onDelete: Cascade)
  ledgerId      String      @map("ledger_id") // 'V01'..'V06'
  plannedValue  Decimal     @map("planned_value")
  minValue      Decimal     @map("min_value")
  maxValue      Decimal     @map("max_value")
  withinRange   Boolean     @map("within_range")

  @@unique([programWeekId, ledgerId])
  @@map("weekly_ledger")
}

// =============================================================================
// Phase 3 — 완료 로그
// =============================================================================

// program_day 1:1. 하루에 한 번만 기록한다고 가정하고, 다시 제출하면 upsert로 덮어쓴다.
// completed=false인 채로 rpe/pain 등만 채워질 수도 있다(예: 부분 완료 메모).
model TrainingLog {
  id                    Int        @id @default(autoincrement())
  programDayId          Int        @unique @map("program_day_id")
  programDay            ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  completed             Boolean    @default(false)
  rpe                   Int? // 1~10
  pain                  Int? // 0~10
  motivation            Int?       // 1~10. MD 7장 웰니스 규칙(수면·통증·의욕 중 2개)에 필요해 Phase 4에서 추가
  sleepHours            Decimal?   @map("sleep_hours")
  actualDurationMinutes Int?       @map("actual_duration_minutes") // session-RPE×분 부하 계산에 사용(Phase 4)
  notes                 String?
  loggedAt              DateTime   @default(now()) @map("logged_at") @updatedAt

  @@map("training_log")
}

// Phase 4 — 피드백 루프가 남기는 감사 로그. 로그 저장 시 자동으로 적용된 조정을 기록해
// "왜 바뀌었는지" 사용자와 코치가 나중에 확인할 수 있게 한다.
model ProgramAdjustmentEvent {
  id            Int      @id @default(autoincrement())
  programId     String   @map("program_id")
  program       Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  programWeekId Int?     @map("program_week_id")
  triggerRule   String   @map("trigger_rule") // 'wellness_2of3' | 'rpe_load_spike' | 'chronic_fatigue'
  actionTaken   String   @map("action_taken") // 사람이 읽을 수 있는 설명
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("program_adjustment_event")
}
