{
  "name": "wod-compiler",
  "version": "0.1.0",
  "private": true,
  "description": "1RM 기반 자동 크로스핏 월간 프로그램 생성 앱",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx scripts/seed/index.ts",
    "db:validate": "tsx scripts/validate/validateRelations.ts",
    "db:export-exercises": "tsx scripts/export/exportExerciseDb.ts",
    "db:backfill-benchmarks": "tsx scripts/backfill/backfillBenchmarks.ts",
    "db:reset": "prisma migrate reset --skip-seed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
