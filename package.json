{
  "name": "wod-compiler",
  "version": "0.1.0",
  "private": true,
  "description": "1RM 기반 자동 크로스핏 월간 프로그램 생성 앱 — Phase 0: 지식베이스 데이터 파운데이션",
  "type": "commonjs",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx scripts/seed/index.ts",
    "db:validate": "tsx scripts/validate/validateRelations.ts",
    "db:reset": "prisma migrate reset --skip-seed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
